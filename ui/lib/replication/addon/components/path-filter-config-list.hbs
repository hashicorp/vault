<h4 class="title is-5">
  Filtered paths
</h4>
<Hds::Form::RadioCard::Group @name="filtered-path-radio-group" @alignment="left" class="has-bottom-margin-m" as |G|>
  <G.RadioCard
    @checked={{not this.config.mode}}
    {{on "change" (fn (mut this.config.mode) null)}}
    data-test-filter-mode="none"
    as |R|
  >
    <R.Icon @name="file-text" />
    <R.Label>Include everything</R.Label>
    <R.Description>All namespaces and mounts in this cluster will be replicated.</R.Description>
  </G.RadioCard>
  <G.RadioCard
    @checked={{eq this.config.mode "allow"}}
    @value="allow"
    {{on "change" (fn (mut this.config.mode) "allow")}}
    data-test-filter-mode="allow"
    as |R|
  >
    <R.Icon @name="file-check" />
    <R.Label>Allow</R.Label>
    <R.Description>Only include the selected namespaces and mounts.</R.Description>
  </G.RadioCard>
  <G.RadioCard
    @checked={{eq this.config.mode "deny"}}
    @value="deny"
    {{on "change" (fn (mut this.config.mode) "deny")}}
    data-test-filter-mode="deny"
    as |R|
  >
    <R.Icon @name="file-x" />
    <R.Label>Deny</R.Label>
    <R.Description>Do not include the selected namespaces and mounts.</R.Description>
  </G.RadioCard>
</Hds::Form::RadioCard::Group>
{{#if (or (eq this.config.mode "allow") (eq this.config.mode "deny"))}}
  <SearchSelect
    @id="paths"
    @labelClass="title is-7"
    @onChange={{action "pathsChanged"}}
    @inputValue={{this.config.paths}}
    @label="Paths in this {{this.config.mode}}"
    @options={{this.autoCompleteOptions}}
    @search={{perform this.setAutoCompleteOptions}}
  />
{{/if}}
{{#if (and (not this.config.mode) this.startedWithMode)}}
  <AlertInline
    data-test-remove-warning
    @type="warning"
    @message="Saving with 'Include everything' will remove any existing filter configuration"
  />
{{/if}}