{{! Replaces ConfirmAction in dropdowns, instead use dd.Interactive + this modal }}
{{! Destructive action confirmation modal that asks "Are you sure?" or similar @confirmTitle }}
{{! If a tracked property is used to pass the list item to the destructive action,  }}
{{! remember to reset item to null via the @onClose action }}

<Hds::Modal
  id="confirm-action-modal"
  class="has-text-left confirm-modal-wide"
  @color={{or @color "warning"}}
  @size="small"
  @onClose={{@onClose}}
  data-test-confirm-modal
  as |M|
>
  {{#if @disabledMessage}}
    <M.Header data-test-confirm-action-title @icon="x-circle">
      Not allowed
    </M.Header>
    <M.Body data-test-confirm-action-message>
      {{@disabledMessage}}
    </M.Body>
    <M.Footer as |F|>
      <Hds::Button data-test-cancel @text="Close" {{on "click" F.close}} />
    </M.Footer>
  {{else}}
    <M.Header data-test-confirm-action-title @icon="alert-circle">
      {{or @confirmTitle "Are you sure?"}}
    </M.Header>
    <M.Body data-test-confirm-action-message>
      {{#if (has-block "body")}}
        {{yield to="body"}}
      {{else}}
        {{or @confirmMessage "You will not be able to recover it later."}}
      {{/if}}
      {{#if @confirmText}}
        <div class="has-top-padding-m">
          <Hds::Form::Label @controlId="confirm-modal-input" @isRequired={{true}}>
            {{or @confirmLabel "Confirm"}}
          </Hds::Form::Label>
          <label class="sub-text has-top-bottom-margin-xxs" for="confirm-modal-input">
            Type "{{@confirmText}}" to confirm
          </label>
          <Hds::Form::TextInput::Base
            @type="text"
            @id="confirm-modal-input"
            class="has-margin-top"
            autocomplete="off"
            spellcheck="false"
            data-test-confirm-modal-input
            {{on "input" this.onInput}}
          />
          {{#if this.showConfirmWarning}}
            <Hds::Form::Error data-test-confirm-modal-warning>
              Input must match "{{@confirmText}}" to confirm
            </Hds::Form::Error>
          {{/if}}
        </div>
      {{/if}}
    </M.Body>
    <M.Footer as |F|>
      <Hds::ButtonSet>
        <Hds::Button
          data-test-confirm-button
          disabled={{@isRunning}}
          @icon={{if @isRunning "loading"}}
          @color={{if (eq @color "critical") "critical" "primary"}}
          @text={{or @confirmButtonText "Confirm"}}
          {{on "click" (fn this.saveAndClose F.close)}}
        />
        <Hds::Button data-test-cancel @color="secondary" @text="Cancel" {{on "click" F.close}} />
      </Hds::ButtonSet>
    </M.Footer>
  {{/if}}
</Hds::Modal>