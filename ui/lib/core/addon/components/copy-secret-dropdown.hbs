<Hds::Dropdown @onClose={{@onClose}} as |D|>
  <D.ToggleButton @text="Copy" @color="secondary" data-test-copy-menu-trigger />
  <D.Interactive @icon="clipboard-copy" {{on "click" (fn this.copyJson D.close)}} data-test-copy-button>
    Copy JSON
  </D.Interactive>
  {{#if @wrappedData}}
    <D.Generic>
      <MaskedInput @displayOnly={{true}} @allowCopy={{true}} @value={{@wrappedData}} />
    </D.Generic>
  {{else}}
    <D.Interactive @isLoading={{@isWrapping}} {{on "click" @onWrap}} data-test-button="wrap">
      Wrap secret
    </D.Interactive>
  {{/if}}
</Hds::Dropdown>