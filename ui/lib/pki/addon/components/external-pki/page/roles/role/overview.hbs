{{#if this.fetchedCert}}
  <ExternalPki::OrderCertDetails @certificate={{hash details=this.fetchedCert}} />
{{else}}
  <Hds::Layout::Flex class="padding-top-24" @gap="24" @wrap={{true}} as |LF|>
    <LF.Item @basis="500px">
      <ExternalPki::FetchCachedCert @errorMessage={{this.errorMessage}} @onSubmit={{this.getCertificate}} />
    </LF.Item>

    <LF.Item @basis="500px">
      <Hds::Layout::Flex @direction="column" @gap="24">
        <OverviewCard
          @cardTitle="Orders"
          @subText="Quickly lookup a certificate order for this role by providing its order ID."
        >
          <:content>
            <Hds::Layout::Flex @gap="8" class="has-top-padding-m" as |LF|>
              <LF.Item @grow={{1}}>
                <InputSearch
                  @id="roleOrderId"
                  @placeholder="01936d8e-7c3..."
                  @onChange={{fn (mut this.roleOrderId)}}
                  @changeEvent="input"
                />
              </LF.Item>
              <LF.Item>
                <Hds::Button
                  @text="Lookup order"
                  @color="secondary"
                  {{on "click" this.lookupOrder}}
                  data-test-button="Lookup order"
                />
              </LF.Item>
            </Hds::Layout::Flex>
          </:content>
        </OverviewCard>

        {{#if this.shouldRenderActiveOrdersCard}}
          <OverviewCard @cardTitle="Active orders">
            <:action>
              <Hds::Link::Standalone
                @text="Active orders"
                @route="external.roles.role.active-orders"
                @icon="chevron-right"
                @iconPosition="trailing"
              />
            </:action>
            <:customSubtext>
              <Hds::Text::Body @color="faint">
                The total number of active, or in progress, orders for this role. Orders that have reached a terminal status,
                such as
                <strong>Completed</strong>
                or
                <strong>Expired</strong>
                are not included.
              </Hds::Text::Body>
            </:customSubtext>
            <:content>
              <Hds::Text::Display
                data-test-overview-card-content="Active orders"
                @tag="p"
                @size="400"
                @weight="medium"
                class="has-top-margin-m"
              >
                {{format-number @model.activeOrders.list.length}}
              </Hds::Text::Display>
            </:content>
          </OverviewCard>
        {{/if}}
      </Hds::Layout::Flex>
    </LF.Item>
  </Hds::Layout::Flex>

  {{! Role configuration details render here! }}
  <ExternalPki::ConfigDetails @config={{@model.role}} />
{{/if}}