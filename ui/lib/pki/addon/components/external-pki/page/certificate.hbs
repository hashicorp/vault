<ExternalPki::HeaderTabs @title="View order" @breadcrumbs={{@breadcrumbs}} @responseTimestamp={{@model.responseTimestamp}}>
  <:refreshButton>
    <Hds::Button
      class="margin-left-auto"
      @color="tertiary"
      @icon="reload"
      @iconPosition="trailing"
      @isInline={{true}}
      @text="Refresh"
      {{on "click" this.refresh}}
      data-test-button="Refresh"
    />
  </:refreshButton>
</ExternalPki::HeaderTabs>

<ExternalPki::OrderCertDetails
  @order={{this.orderParams}}
  @certificate={{this.certParams}}
  @orderId={{@model.certLookup.order_id}}
  @engineId={{@model.engine.id}}
/>