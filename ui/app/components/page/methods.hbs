{{#if this.showPageHeader}}
  <Page::Header @title="Authentication methods" @icon="lock">
    <:breadcrumbs>
      <Page::Breadcrumbs @breadcrumbs={{@breadcrumbs}} />
    </:breadcrumbs>
    <:description>
      Configure authentication methods for accessing Vault.
      <Hds::Link::Inline @isHrefExternal={{true}} @href={{doc-link "/vault/gui/mfa"}}>
        Learn more
      </Hds::Link::Inline>
    </:description>
    <:actions>
      {{#if this.showIntroButton}}
        <Hds::Button
          class="has-right-margin-4"
          @color="secondary"
          @icon="bulb"
          @text="New to Auth methods?"
          {{on "click" this.showIntroPage}}
          data-test-button="intro"
        />
      {{/if}}
      <Hds::Button
        @text="Enable new method"
        @icon="plus"
        @route="vault.cluster.settings.auth.enable"
        data-test-auth-enable
      />
    </:actions>
  </Page::Header>
{{/if}}

{{#if this.showWizard}}
  <Wizard::Methods::MethodsWizard @isIntroModal={{this.shouldRenderIntroModal}} @onRefresh={{this.refreshMethodsList}} />
{{/if}}

{{#if this.showContent}}
  {{! Filters Section }}
  <Hds::SegmentedGroup class="top-margin-12" as |SG|>
    <SG.TextInput
      @width="300px"
      @type="search"
      placeholder="Search by name"
      aria-label="Search"
      data-test-input-search="auth-method-name"
      {{on "input" (fn this.setSearchText "name")}}
    />
    <SG.Dropdown @width="175px" as |D|>
      <D.Header @hasDivider={{true}}>
        <SG.TextInput
          @type="search"
          placeholder="Search"
          aria-label="Search"
          {{on "input" (fn this.setSearchText "type")}}
        />
      </D.Header>
      <D.ToggleButton @color="secondary" @text="Auth type" data-test-toggle-input="filter-by-auth-type" />
      {{#each this.authMethodArrayByType as |type|}}
        <D.Checkbox
          value={{type.name}}
          checked={{includes type.name this.authTypeFilters}}
          {{on "click" (fn this.filterByAuthType type.name)}}
          data-test-checkbox={{type.name}}
        > <Hds::Icon @name={{type.icon}} @isInline={{true}} class="is-v-centered" /> {{type.name}}</D.Checkbox>
      {{/each}}
    </SG.Dropdown>
  </Hds::SegmentedGroup>

  <Hds::Layout::Flex @gap="8" class="has-top-margin-xs has-bottom-margin-xs" @align="center">
    {{#if this.authTypeFilters}}
      <Hds::Text::Body>Filters applied:</Hds::Text::Body>
      {{#each this.authTypeFilters as |type|}}
        <Hds::Tag @text={{type}} @onDismiss={{fn this.filterByAuthType type}} data-test-button={{type}} />
      {{/each}}
      <Hds::Button
        @text="Clear all"
        @color="tertiary"
        @icon="x"
        @size="small"
        data-test-button="Clear all"
        {{on "click" this.clearAllFilters}}
      />
    {{else}}
      <Hds::Text::Body class="has-top-padding-xs">No filters applied.</Hds::Text::Body>
    {{/if}}
  </Hds::Layout::Flex>
  {{! End Filters Section }}

  {{! Table Section }}
  {{#if this.authMethodList}}
    <ListTable class="has-top-margin-xs" @columns={{this.tableColumns}} @data={{this.authMethodList}}>
      <:customTableItem as |itemData|>
        {{#let (this.getAuthMethodData itemData.path) as |method|}}
          {{#if method}}
            <Hds::TooltipButton
              @text={{method.methodType}}
              aria-label="Type of auth mount"
              data-test-button={{method.methodType}}
              isInline={{true}}
              class="is-v-centered"
            >
              <Icon @name={{if method.icon method.icon "lock"}} class="has-text-grey-light" />
            </Hds::TooltipButton>
            <Hds::Link::Inline
              @route="vault.cluster.access.method"
              @model={{method.id}}
              @color="secondary"
              class="has-text-weight-semibold"
              data-test-link-to={{method.path}}
            >{{method.path}}</Hds::Link::Inline>
          {{/if}}
        {{/let}}
      </:customTableItem>

      <:popupMenu as |rowData|>
        {{#let (this.getAuthMethodData rowData.path) as |method|}}
          {{#if method}}
            <Hds::Dropdown @isInline={{true}} @listPosition="bottom-right" as |dd|>
              <dd.ToggleIcon
                @icon="more-horizontal"
                @text="Overflow options"
                @hasChevron={{false}}
                data-test-popup-menu-trigger
              />
              <dd.Interactive @route="vault.cluster.access.method.section" @models={{array method.id "configuration"}}>
                View configuration
              </dd.Interactive>
              {{#if
                (or
                  (has-capability @model.capabilities "update" pathKey="authMethodConfig" params=method.id)
                  (and
                    (eq method.methodType "aws")
                    (has-capability @model.capabilities "update" pathKey="authMethodConfigAws" params=method.id)
                  )
                )
              }}
                <dd.Interactive @route="vault.cluster.settings.auth.configure" @model={{method.id}}>
                  Edit configuration
                </dd.Interactive>
              {{/if}}
              {{#if
                (and
                  (not-eq method.methodType "token")
                  (has-capability @model.capabilities "delete" pathKey="authMethodDelete" params=method.id)
                )
              }}
                <dd.Interactive
                  @color="critical"
                  {{on "click" (fn (mut this.methodToDisable) method)}}
                  data-test-button="Disable auth method"
                >
                  Disable
                </dd.Interactive>
              {{/if}}
            </Hds::Dropdown>
          {{/if}}
        {{/let}}
      </:popupMenu>
    </ListTable>
  {{else}}
    <Hds::ApplicationState class="top-padding-32 is-marginless" as |A|>
      <A.Header @title="No Authentication Methods found" @titleTag="h2" data-test-empty-state-title />
    </Hds::ApplicationState>
  {{/if}}

  {{#if this.methodToDisable}}
    <ConfirmModal
      @color="critical"
      @confirmTitle="Disable method?"
      @confirmMessage="This may affect access to Vault data."
      @onClose={{fn (mut this.methodToDisable) null}}
      @onConfirm={{perform this.disableMethod this.methodToDisable}}
    />
  {{/if}}
{{/if}}