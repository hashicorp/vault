<Page::Header @icon="dashboard" @title="Upgrade path analyzer">
  <:breadcrumbs>
    <Page::Breadcrumbs @breadcrumbs={{@breadcrumbs}} />
  </:breadcrumbs>
  <:actions>
    <Hds::Button
      @text="CLI & API quick reference"
      @color="tertiary"
      @icon="terminal"
      {{on "click" (fn (mut this.isModalOpen) true)}}
    />
  </:actions>
  <:description>
    Select a target version to analyze the upgrade path from your current running cluster.
  </:description>
</Page::Header>

{{#if this.hasError}}
  <Hds::ApplicationState class="top-padding-32" as |A|>
    <A.Header @icon="skip" @title="Nothing to see here" />
    <A.Body @text="Something has gone wrong. Please review your network policies which may be restricting this feature. " />
  </Hds::ApplicationState>
{{else}}
  <Hds::Card::Container
    @level="mid"
    @hasBorder={{true}}
    class="has-padding-24 top-margin-32 bottom-margin-32"
    data-test-card-container="version-selection"
  >
    <Hds::Layout::Flex @align="center" @gap="16" @justify="space-between" as |LF|>
      <Hds::Form::Select::Field disabled name="current-version" data-test-select={{this.currentVersion}} as |F|>
        <F.Label>Current version</F.Label>
        <F.Options>
          <option value={{this.currentVersion}} selected>{{this.currentVersion}}</option>
        </F.Options>
      </Hds::Form::Select::Field>

      <LF.Item>
        <Hds::Icon @name="arrow-right" @size="24" />
      </LF.Item>

      <Hds::Form::Select::Field
        name="target-version"
        {{on "change" this.onVersionSelect}}
        data-test-select="target version"
        as |F|
      >
        <F.Label>Target version</F.Label>
        <F.Options>
          <option value="" selected disabled>Select a target version</option>
          {{#each this.filteredTargetVersions as |version|}}
            <option value={{version}}>{{version}}</option>
          {{/each}}
        </F.Options>
      </Hds::Form::Select::Field>

      <Hds::Button
        @icon="arrow-up-circle"
        @text="Analyze"
        class="align-self-end"
        data-test-button="Analyze"
        {{on "click" this.onAnalyzeClick}}
      />
    </Hds::Layout::Flex>
  </Hds::Card::Container>

  {{#if this.upgradeInfo}}
    <Hds::Layout::Grid @columnMinWidth="50%" @gap="16">
      {{#each this.cards as |card index|}}
        <Hds::Card::Container
          @level="mid"
          @hasBorder={{true}}
          class="has-padding-12"
          data-test-card-container={{card.title}}
        >
          <Hds::Layout::Flex @direction="column" @gap="12" as |LF|>
            <LF.Item>
              <Hds::Layout::Flex @align="center" @gap="8">
                <Hds::Icon @name={{card.icon}} @size="24" />
                <Hds::Text::Display @tag="h2" @weight="semibold" data-test-card-title>{{card.title}}</Hds::Text::Display>
                <Hds::BadgeCount @text={{card.count}} @type="inverted" data-test-badge />
              </Hds::Layout::Flex>

              <Hds::Text::Body @tag="p" data-test-card-description>
                {{card.description}}
              </Hds::Text::Body>
            </LF.Item>

            <Hds::Link::Standalone
              @icon="arrow-right"
              @iconPosition="trailing"
              @text="View"
              @route="vault.cluster.support.upgrade-info"
              @query={{hash tab=index}}
              data-test-link-to={{card.title}}
            />
          </Hds::Layout::Flex>
        </Hds::Card::Container>
      {{/each}}
    </Hds::Layout::Grid>

    <Hds::Layout::Flex @direction="column" @gap="16" class="padding-top-24">
      <Hds::Layout::Flex @align="center" @justify="space-between" @gap="16">
        <Hds::Text::Display @tag="h2" @weight="semibold" data-test-upgrade-steps-title>
          Upgrade steps
        </Hds::Text::Display>

        <DownloadButton
          @text="Download steps"
          @data={{this.upgradeStepsDownloadText}}
          @filename="vault-upgrade-steps"
          @color="tertiary"
          @iconPosition="leading"
          data-test-button="Download steps"
        />

      </Hds::Layout::Flex>

      <Hds::Alert @type="inline" @color="highlight" @icon="info" data-test-inline-alert as |A|>
        <A.Title>{{this.upgradeGuidanceMessage}}</A.Title>
      </Hds::Alert>

      <Hds::Text::Body @tag="p" @weight="semibold">Upgrade order:</Hds::Text::Body>
      <Hds::Separator @spacing="0" />
      <Hds::Layout::Flex @direction="column" @gap="8">
        {{#each this.upgradeOrder as |step index|}}
          <Hds::Layout::Flex @align="start" @gap="8">
            <Hds::Text::Body @tag="span">{{inc index}}.</Hds::Text::Body>
            <Hds::Text::Body @tag="span">{{step}}</Hds::Text::Body>
          </Hds::Layout::Flex>
        {{/each}}
      </Hds::Layout::Flex>

      <Hds::Text::Body @tag="p" @weight="semibold">Detailed upgrade steps</Hds::Text::Body>
      <Hds::Separator @spacing="0" />
      <Hds::Layout::Flex @direction="column" @gap="8">
        {{#each this.upgradeSteps as |step index|}}
          <Hds::Layout::Flex @align="start" @gap="8">
            <Hds::Text::Body @tag="span">{{inc index}}.</Hds::Text::Body>
            <Hds::Text::Body @tag="span">
              {{step}}
            </Hds::Text::Body>
          </Hds::Layout::Flex>
        {{/each}}
      </Hds::Layout::Flex>
    </Hds::Layout::Flex>
  {{else}}
    {{#if this.isLoading}}
      <Hds::Layout::Flex @justify="center" @align="center" class="is-medium-height">
        <VaultLogoSpinner />
      </Hds::Layout::Flex>
    {{/if}}
  {{/if}}
{{/if}}

{{#if this.isModalOpen}}
  <Hds::Modal id="quick-reference" as |M|>
    <M.Header @icon="terminal">
      CLI & API quick reference
    </M.Header>
    <M.Body>
      <Hds::Text::Body @tag="p">CLI/API quick commands to help you with your upgrade process.</Hds::Text::Body>
      <Hds::Text::Body @tag="p" @weight="semibold" class="top-padding-20">Check current version</Hds::Text::Body>
      <Hds::CodeBlock
        @ariaLabel="copy button"
        @hasCopyButton={{true}}
        @copyButtonText="Copy command"
        @value="vault status | grep Version"
      />
      <Hds::Text::Body @tag="p" @weight="semibold" class="top-padding-20">Create primary snapshot</Hds::Text::Body>
      <Hds::CodeBlock
        @ariaLabel="copy button"
        @hasCopyButton={{true}}
        @copyButtonText="Copy command"
        @value="vault operator raft snapshot save primary.snap"
      />
      <Hds::Text::Body @tag="p" @weight="semibold" class="top-padding-20">Verify post-upgrade cluster</Hds::Text::Body>
      <Hds::CodeBlock
        @ariaLabel="copy button"
        @hasCopyButton={{true}}
        @copyButtonText="Copy command"
        @value="vault status"
      />
    </M.Body>
    <M.Footer>
      <Hds::Button type="button" @text="Close" {{on "click" (fn (mut this.isModalOpen) false)}} />
    </M.Footer>
  </Hds::Modal>
{{/if}}