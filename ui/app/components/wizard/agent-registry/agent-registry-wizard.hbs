<Wizard
  @wizardId={{this.wizardId}}
  @isModal={{@isIntroModal}}
  @title="Agent registry"
  @customHeader="Register and govern AI agent identities in Vault"
  @onDismiss={{this.onDismiss}}
>
  <:intro>
    <Wizard::AgentRegistry::Intro />
  </:intro>
  <:introActions>
    {{! TODO: confirm these are the correct documentation links }}
    <Hds::ButtonSet>
      <Hds::Button
        @icon="external-link"
        @text="Register via CLI"
        @href={{doc-link "/vault/docs/ai/agent-registry/manage-registration"}}
        @iconPosition="trailing"
        data-test-button="enable"
      />
      <Hds::Button
        @color="secondary"
        @text={{if @isIntroModal "Close" "Skip"}}
        {{on "click" this.onDismiss}}
        data-test-button="Skip"
      />
      <Hds::Link::Standalone
        @icon="docs-link"
        @iconPosition="trailing"
        @text="View documentation"
        @href={{doc-link "/vault/docs/concepts/native-ai-agent-support"}}
        class="margin-left-auto"
      />
    </Hds::ButtonSet>
  </:introActions>
</Wizard>