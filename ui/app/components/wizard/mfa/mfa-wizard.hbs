<Wizard
  @wizardId={{this.wizardId}}
  @isModal={{@isIntroModal}}
  @title="Require a second factor at login"
  @onDismiss={{this.onDismiss}}
>
  <:intro>
    <Wizard::Mfa::Intro />
  </:intro>
  <:introActions>
    <Hds::ButtonSet>
      <Hds::Button
        @icon="plus"
        @text="Configure MFA"
        @route="vault.cluster.access.mfa.methods.create"
        {{on "click" (fn this.trackClickEvent "Configure MFA")}}
        data-test-button="Configure MFA"
      />
      <Hds::Button
        @color="secondary"
        @text={{if @isIntroModal "Close" "Skip"}}
        {{on "click" this.onDismiss}}
        data-test-button={{if @isIntroModal "Close" "Skip"}}
      />
      <Hds::Link::Standalone
        @icon="docs-link"
        @iconPosition="trailing"
        @text="View documentation"
        @href={{doc-link "/vault/gui/login-mfa"}}
        {{on "click" (fn this.trackClickEvent "View documentation")}}
        class="margin-left-auto"
      />
    </Hds::ButtonSet>
  </:introActions>
</Wizard>