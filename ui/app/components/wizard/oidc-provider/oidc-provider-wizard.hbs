<Wizard @wizardId={{this.wizardId}} @isModal={{@isIntroModal}} @title="OIDC Provider" @onDismiss={{this.onDismiss}}>
  <:intro>
    <Wizard::OidcProvider::Intro />
  </:intro>
  <:introActions>
    <Hds::ButtonSet>
      <Hds::Button
        @icon="plus"
        @text="Configure OIDC Provider"
        @route="vault.cluster.access.oidc.clients.create"
        {{on "click" (fn this.trackClickEvent "Configure OIDC Provider")}}
        data-test-button="Configure OIDC Provider"
      />
      <Hds::Button
        @color="secondary"
        @text={{if @isIntroModal "Close" "Skip"}}
        {{on "click" this.onDismiss}}
        data-test-button={{if @isIntroModal "Close" "Skip"}}
      />
      <Hds::Link::Standalone
        @icon="docs-link"
        @iconPosition="trailing"
        @text="View documentation"
        @href={{doc-link "/vault/docs/secrets/identity/oidc-provider"}}
        {{on "click" (fn this.trackClickEvent "View documentation")}}
        class="margin-left-auto"
      />
    </Hds::ButtonSet>
  </:introActions>
</Wizard>