<Hds::Layout::Flex @align="start" @direction="column" as |LF|>
  <Hds::Text::Body @tag="p" class="bottom-margin-16">
    {{#if (has-block "description")}}
      {{yield to="description"}}
    {{else}}
      {{@description}}
    {{/if}}
  </Hds::Text::Body>

  {{! Collect only the truthy badges so the first rendered badge never gets a left margin }}
  <LF.Item>
    {{#each
      (compact
        (array
          (if @setupTime (hash text=(concat "Setup time: " @setupTime)))
          (if @isOptional (hash text="Optional" type="outlined"))
          (if @isBeta (hash text="Beta"))
          (if @isEnterprise (hash text="Enterprise" color="highlight"))
        )
      )
      as |badge index|
    }}
      <Hds::Badge
        @text={{badge.text}}
        @type={{badge.type}}
        @color={{badge.color}}
        class={{if (gt index 0) "has-left-margin-xs"}}
      />
    {{/each}}
  </LF.Item>

  <LF.Item class="top-margin-36">
    {{yield to="features"}}
  </LF.Item>
</Hds::Layout::Flex>

<Hds::Layout::Flex @direction="column" class={{@imageClass}} data-test-intro-content-image-container>
  <img src={{this.introPageImgSrc}} alt={{@imageAlt}} class={{@imageClass}} data-test-intro-content-image />
  <Hds::Text::Body @align="left" @color="faint" @size="100" @tag="p">{{@imageCaption}}</Hds::Text::Body>
</Hds::Layout::Flex>