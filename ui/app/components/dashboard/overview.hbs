<Page::Header
  @title="Vault {{@version.versionDisplay}}"
  @icon="dashboard"
  @description="Review the status of your Vault cluster, including: currently enabled secrets engines and authentication methods, and system configurations."
  class="dashboard-header-with-gradient has-bottom-margin-xl"
>
  <:badges>
    {{#if @version.isEnterprise}}
      <Hds::Badge @text={{this.namespace.currentNamespace}} @icon="org" data-test-badge-namespace />
    {{/if}}
  </:badges>
</Page::Header>

<div class="has-bottom-margin-xl">
  <Hds::Layout::Flex @wrap={{true}} @gap="48" as |LF|>
    {{#if @version.isEnterprise}}
      <LF.Item @basis="58%" @grow={{true}} @shrink={{true}}>
        {{#if this.shouldShowChecklist}}
          <Dashboard::Widgets::Checklist
            @checklist={{this.startupChecklist}}
            @checklistId={{this.startupChecklist.id}}
            @visibleSteps={{this.visibleSteps}}
            @onHide={{this.hideChecklist}}
            @onStepCompletionChange={{this.handleChecklistStepCompletionChange}}
          />
          <Dashboard::Widgets::SecretsEngines @secretsEngines={{@secretsEngines}} class="has-top-margin-xl" />
        {{else if (eq this.checklistLifecycleState "complete")}}
          <Dashboard::Widgets::CongratsBanner @onDismiss={{this.hideChecklist}} @onBack={{this.showSetupGuide}} />
          <Dashboard::Widgets::SecretsEngines @secretsEngines={{@secretsEngines}} class="has-top-margin-xl" />
        {{else if (or (eq this.checklistLifecycleState "hidden") (eq this.checklistLifecycleState "post-completion"))}}
          <Dashboard::Widgets::SecretsEngines @secretsEngines={{@secretsEngines}} />
          <Dashboard::Widgets::ExploreVault
            @onRestore={{this.restoreChecklist}}
            @isPostCompletion={{eq this.checklistLifecycleState "post-completion"}}
            class="has-top-margin-xl"
          />
        {{else}}
          {{! null lifecycleState: CE, fetch failed, or no visible steps — show normal content }}
          <Dashboard::Widgets::SecretsEngines @secretsEngines={{@secretsEngines}} />
          {{#if
            (and (has-permission "status" routeParams="replication") (not (is-empty-value @replication)) @isRootNamespace)
          }}
            <Dashboard::Widgets::Replication
              @replication={{@replication}}
              @version={{@version}}
              @refresh={{@refreshModel}}
              @updatedAt={{@replicationUpdatedAt}}
              class="has-top-margin-xl"
            />
          {{/if}}
          {{#if @vaultConfiguration}}
            <Dashboard::Widgets::ClusterConfiguration @vaultConfiguration={{@vaultConfiguration}} />
          {{/if}}
        {{/if}}
      </LF.Item>

      <LF.Item @basis="calc(33.33% - 24px)" @grow={{true}} @shrink={{true}}>
        <Dashboard::Widgets::FeatureSpotlight
          @title="New Agent Registry in Vault"
          @description="Centralized view of registered AI agents and their owners in Vault."
          @link="/vault/docs/ai/agent-registry"
          @imageSrc={{img-path "~/agent-registry-dashboard.png"}}
          class="has-bottom-margin-xl"
        />
        <Dashboard::Widgets::QuickActions @secretsEngines={{@secretsEngines}} />
        {{#if (and (has-permission "clients" routeParams="activity") this.shouldShowClientCount)}}
          <Dashboard::Widgets::ClientCount class="has-top-margin-xl" />
        {{/if}}

        <Dashboard::Widgets::LearnMore @isEnterprise={{@version.isEnterprise}} class="has-top-margin-xl" />
      </LF.Item>
    {{else}}
      <LF.Item @basis="calc(66.67% - 24px)" @grow={{true}} @shrink={{true}}>
        <Dashboard::Widgets::SecretsEngines @secretsEngines={{@secretsEngines}} />
        {{#if @vaultConfiguration}}
          <Dashboard::Widgets::ClusterConfiguration @vaultConfiguration={{@vaultConfiguration}} />
        {{/if}}
      </LF.Item>
      <LF.Item @basis="calc(33.33% - 24px)" @grow={{true}} @shrink={{true}}>
        <Dashboard::Widgets::QuickActions @secretsEngines={{@secretsEngines}} />
        <Dashboard::Widgets::LearnMore @isEnterprise={{@version.isEnterprise}} class="has-top-margin-xl" />
      </LF.Item>
    {{/if}}
  </Hds::Layout::Flex>
</div>