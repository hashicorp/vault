<Page::Header @title={{this.title}} @subtitle={{this.subtitle}}>
  <:breadcrumbs>
    <KeyValueHeader
      @baseKey={{this.form}}
      @path="vault.cluster.secrets.backend.list"
      @mode={{@mode}}
      @root={{this.breadcrumbs}}
      @showCurrent={{true}}
    />
  </:breadcrumbs>
</Page::Header>

<MessageError @errorMessage={{this.errorMessage}} />

{{#if (eq @mode "show")}}
  <Toolbar>
    <ToolbarActions>
      {{#if @capabilities.canDelete}}
        <ConfirmAction
          @buttonText="Delete role"
          class="toolbar-button"
          @buttonColor="secondary"
          @onConfirmAction={{this.delete}}
        />
        <div class="toolbar-separator"></div>
      {{/if}}
      {{#if @capabilities.canGenerate}}
        <ToolbarSecretLink @secret={{this.form.data.name}} @mode="credentials" data-test-backend-credentials>
          Generate credentials
        </ToolbarSecretLink>
      {{/if}}
      {{#if @capabilities.canEdit}}
        <ToolbarSecretLink @secret={{this.form.data.name}} @mode="edit" @replace={{true}}>
          Edit role
        </ToolbarSecretLink>
      {{/if}}
    </ToolbarActions>
  </Toolbar>
{{/if}}

{{#if (or (eq @mode "edit") (eq @mode "create"))}}
  <form {{on "submit" this.save}}>
    <div class="box is-sideless is-fullwidth is-marginless">
      <NamespaceReminder @mode={{@mode}} @noun="AWS role" />
      {{#each (if (eq @mode "edit") (drop 1 this.form.formFields) this.form.formFields) as |attr|}}
        <FormField @attr={{attr}} @model={{this.form}} data-test-field={{true}} />
      {{/each}}
    </div>
    <div class="field is-grouped-split box is-fullwidth is-bottomless">
      <Hds::ButtonSet>
        <Hds::Button
          @text={{if (eq @mode "create") "Create role" "Save"}}
          type="submit"
          disabled={{this.isSaving}}
          data-test-submit
        />
        {{#if (eq @mode "create")}}
          <Hds::Button
            @text="Cancel"
            @color="secondary"
            @route="vault.cluster.secrets.backend.list-root"
            @model={{this.form.data.backend}}
          />
        {{else}}
          <Hds::Button
            @text="Cancel"
            @color="secondary"
            @route="vault.cluster.secrets.backend.show"
            @models={{array this.form.data.backend this.form.data.name}}
          />
        {{/if}}
      </Hds::ButtonSet>
    </div>
  </form>
{{else}}
  <div class="box is-fullwidth is-sideless is-paddingless is-marginless">
    {{#each this.form.formFields as |attr|}}
      {{#if (eq attr.name "policy_document")}}
        <InfoTableRow
          @label={{capitalize (or attr.options.label (humanize (dasherize attr.name)))}}
          @value={{this.form.data.policy_document}}
        >
          <pre><code class="is-paddingless">{{stringify (jsonify this.form.data.policy_document)}}</code></pre>
        </InfoTableRow>
      {{else}}
        <InfoTableRow
          @label={{capitalize (or attr.options.label (humanize (dasherize attr.name)))}}
          @value={{get this.form.data attr.name}}
        />
      {{/if}}
    {{/each}}
  </div>
{{/if}}