<Hds::Card::Container @level="mid" @hasBorder={{true}} class="has-padding-l" ...attributes>
  <form {{on "submit" this.transitionToCredential}}>
    <Hds::Layout::Flex @justify="space-between" class="is-fullwidth">
      <Hds::Text::Display
        class="has-bottom-margin-s"
        @weight="semibold"
        @size="300"
        data-test-credentials-card-title={{@title}}
      >
        {{@title}}
      </Hds::Text::Display>
    </Hds::Layout::Flex>
    <SearchSelect
      @id="search-input-role"
      @models={{@models}}
      @selectLimit="1"
      @backend={{@backend}}
      @fallbackComponent="input-search"
      @onChange={{this.handleInput}}
      @placeholder={{@placeholder}}
      @label={{@searchLabel}}
    />
    <Hds::Button
      @text="Get credentials"
      type="submit"
      @color="secondary"
      disabled={{not this.role}}
      data-test-button="Get credentials"
    />
  </form>
</Hds::Card::Container>