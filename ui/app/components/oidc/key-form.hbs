<form {{on "submit" (perform this.save)}}>
  <div class="box is-sideless is-fullwidth is-bottomless">
    <MessageError @errorMessage={{this.errorBanner}} />
    <FormFieldGroups @model={{@form}} @groupName="formFieldGroups" @modelValidations={{this.modelValidations}} />
  </div>
  {{#unless @isModalForm}}
    {{! RADIO CARD + SEARCH SELECT }}
    <div class="box is-sideless is-fullwidth is-marginless has-top-padding-xl">
      <Hds::Text::Display @tag="h2" @size="400">Allowed applications</Hds::Text::Display>
      <Hds::Form::RadioCard::Group
        @name="allowed-applications-radio-group"
        class="has-top-margin-s has-bottom-margin-m"
        @alignment="left"
        as |G|
      >
        <G.RadioCard
          @checked={{eq this.radioCardGroupValue "allow_all"}}
          {{on "change" (fn this.handleClientSelection "allow_all")}}
          @value="allow_all"
          data-test-oidc-radio="allow-all"
          as |R|
        >
          <R.Icon @name="globe" />
          <R.Label>Allow every application to use</R.Label>
          <R.Description>All applications can use this key for authentication requests.</R.Description>
        </G.RadioCard>
        <G.RadioCard
          @checked={{eq this.radioCardGroupValue "limited"}}
          @disabled={{@form.isNew}}
          @value="limited"
          {{on "change" (fn this.handleClientSelection "limited")}}
          data-test-oidc-radio="limited"
          as |R|
        >
          <R.Icon @name="globe-private" />
          <R.Label>Limit access to selected application</R.Label>
          <R.Description data-test-oidc-radio-description="limited">
            {{if
              @form.isNew
              "This option has been disabled for now. To limit access, you must first create an application that references this key."
              "Only selected applications can use this key for authentication requests."
            }}
          </R.Description>
        </G.RadioCard>
      </Hds::Form::RadioCard::Group>

      {{#if (eq this.radioCardGroupValue "limited")}}
        {{! clients are fetched in route and passed into select component }}
        <SearchSelect
          @id="oidc-key-form-client-select"
          @label="Application name"
          @subText="Select which applications are allowed to use this key. Only applications that currently reference this key will appear in the dropdown."
          @options={{@clients}}
          @parentManageSelected={{this.selectedClients}}
          @onChange={{this.handleClientSelection}}
          @disallowNewItems={{true}}
          @fallbackComponent="string-list"
          @passObject={{true}}
          @objectKeys={{array "client_id"}}
          @shouldRenderName={{true}}
          @renderTooltip={{this.renderTooltip}}
        />
      {{/if}}
    </div>
  {{/unless}}
  <div class="field box is-fullwidth is-bottomless">
    <div class="control">
      <Hds::Button
        @text={{if @form.isNew "Create" "Update"}}
        @icon={{if this.save.isRunning "loading"}}
        type="submit"
        disabled={{this.save.isRunning}}
        data-test-oidc-key-save
      />
      <Hds::Button
        @text="Cancel"
        @color="secondary"
        class="has-left-margin-s"
        disabled={{this.save.isRunning}}
        {{on "click" @onCancel}}
        data-test-oidc-key-cancel
      />
    </div>
    {{#if this.invalidFormAlert}}
      <div class="control">
        <AlertInline @type="danger" class="has-top-padding-s" @message={{this.invalidFormAlert}} />
      </div>
    {{/if}}
  </div>
</form>