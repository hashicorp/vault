<Page::Header
  @title="Entities"
  @description="Create and manage unique identities for human and non-human identities to serve as the canonical reference ID for policies and metadata."
>
  <:breadcrumbs>
    <Page::Breadcrumbs
      @breadcrumbs={{array (hash label="Vault" route="vault.cluster.dashboard" icon="vault") (hash label="Entities")}}
    />
  </:breadcrumbs>
  <:actions>
    <Hds::Button
      @color="secondary"
      @text="Merge entities"
      @route="vault.cluster.access.identity.entities.merge"
      data-test-button="entity-merge-link"
    />
    <Hds::Button
      @color="primary"
      @icon="plus"
      @text="Create new entity"
      @route="vault.cluster.access.identity.entities.create"
      data-test-button="entity-create-link"
    />
  </:actions>
</Page::Header>

{{#if @model.meta.total}}
  <Identity::Entities::Table
    @model={{@model}}
    @onClickEntity={{this.openEntityFlyout}}
    @onClickAlias={{this.openAliasFlyout}}
  />
{{else}}
  <Hds::ApplicationState class="top-padding-32 is-marginless" as |A|>
    <A.Header data-test-empty-state-title @title="No entities yet" @titleTag="h2" />
    <A.Body
      data-test-empty-state-message
      @text="A list of entities in this namespace will be listed here. Create your first entity to get started."
    />
    <A.Footer data-test-empty-state-actions as |F|>
      <F.LinkStandalone
        @text="Identity: entities and groups tutorial"
        @href={{doc-link "/vault/tutorials/auth-methods/identity"}}
        @icon="learn-link"
        @iconPosition="trailing"
      />
    </A.Footer>
  </Hds::ApplicationState>
{{/if}}

{{#if this.showEntityFlyout}}
  <Identity::Entities::Flyout
    @data={{this.entityFlyoutData}}
    @initialTab={{this.entityFlyoutInitialTab}}
    @onClose={{this.onEntityFlyoutClose}}
  />
{{/if}}