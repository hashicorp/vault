{{#if (not (is-empty @model.parent_group_ids))}}
  {{#each @model.parent_group_ids as |gid|}}
    <LinkedBlock @params={{array "vault.cluster.access.identity.show" "groups" gid this.details}} class="list-item-row">
      <Hds::Layout::Flex @direction="row" @align="center" @gap="16" as |LF|>
        <LF.Item @grow={{true}} @shrink={{true}}>
          <LinkTo
            @route="vault.cluster.access.identity.show"
            @models={{array "groups" gid "details"}}
            class="is-block has-text-black has-text-weight-semibold"
          >
            <Icon @name="folder" class="has-text-grey-light" />
            <Identity::ItemName @id={{gid}} @items={{@model.groups}} />
          </LinkTo>
        </LF.Item>
      </Hds::Layout::Flex>
    </LinkedBlock>
  {{/each}}
{{else}}
  <Hds::ApplicationState class="top-padding-32 is-marginless" as |A|>
    <A.Header data-test-empty-state-title @title="This group has no parent groups yet" @titleTag="h2" />
  </Hds::ApplicationState>
{{/if}}